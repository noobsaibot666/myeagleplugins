{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "punycode": ["types/shims.d.ts"],
      "node:punycode": ["types/shims.d.ts"]
    }
  },
  "exclude": ["node_modules"]
}
